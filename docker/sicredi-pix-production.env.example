# Copiar para /etc/detudoja/sicredi-pix-production.env na VPS, permissao 600.
# Somente o teste de autenticacao. Nao alterar apps/api/.env nem o gateway ativo.
# Preencha valores sem aspas, sem export e sem comentarios depois dos valores.
SICREDI_PIX_TEST_ENV=production
SICREDI_PIX_TEST_CLIENT_ID=
SICREDI_PIX_TEST_CLIENT_SECRET=
# Somente se a chave privada estiver protegida por senha:
# SICREDI_PIX_TEST_CERT_PASSPHRASE=
