# Copie para /etc/detudoja/sicredi-pix-sandbox.env na VPS (fora do repositorio).
# Somente teste. Nao altera apps/api/.env nem o gateway do aplicativo.

# Chave RECEBEDORA do ambiente Pix de homologacao, necessaria para criar.
# Nao use a chave de DESTINO do exemplo de transferencia Multipag.
SICREDI_PIX_TEST_RECEIVING_KEY=

# Opcional: par especifico para este teste (sempre preencher ambos).
# Sem este par, usa SICREDI_PIX_CLIENT_*; se ausentes, testa o par
# SICREDI_MULTIPAG_CLIENT_* ja existente. O log informa somente a origem.
# SICREDI_PIX_TEST_CLIENT_ID=
# SICREDI_PIX_TEST_CLIENT_SECRET=
