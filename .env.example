# Copie este arquivo para .env antes de iniciar o Docker Compose:
# cp .env.example .env
# O arquivo .env e ignorado pelo Git e deve conter os valores reais da VPS.

POSTGRES_USER=brasilcashback
POSTGRES_PASSWORD=troque-por-uma-senha-forte-na-vps
POSTGRES_DB=brasil_cashback

# Portas acessiveis somente na propria VPS. O Nginx publica os subdominios.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=3333
WEB_ADMIN_HOST_PORT=8081

# O painel e compilado apontando diretamente para o subdominio da API.
VITE_API_URL=https://api-brasil.testes-techcode.shop

# Backup interno do PostgreSQL.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# Backup externo opcional (perfil offsite-backup). Deixe vazio enquanto nao usar.
OFFSITE_BACKUP_INTERVAL_SECONDS=86400
OFFSITE_BACKUP_KEEP_DAILY=14
OFFSITE_BACKUP_KEEP_WEEKLY=8
OFFSITE_BACKUP_KEEP_MONTHLY=12
RESTIC_PASSWORD=
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
