model TipoCarteira {
  id                    Int                @id @default(autoincrement())
  codigo                String             @unique @db.VarChar(80)
  nome                  String             @db.VarChar(120)
  descricao             String?
  permite_saque         Boolean            @default(false)
  permite_uso_em_compra Boolean            @default(false)
  status                StatusTipoCarteira @default(ATIVO)
  criado_em             DateTime           @default(now()) @db.Timestamptz(3)
  atualizado_em         DateTime           @updatedAt @db.Timestamptz(3)

  carteiras Carteira[]

  @@index([status])
  @@map("tipos_carteira")
}

model Carteira {
  id                        Int            @id @default(autoincrement())
  usuario_id                Int
  tipo_carteira_id          Int
  saldo_disponivel_centavos BigInt         @default(0) @db.BigInt
  saldo_pendente_centavos   BigInt         @default(0) @db.BigInt
  saldo_bloqueado_centavos  BigInt         @default(0) @db.BigInt
  status                    StatusCarteira @default(ATIVA)
  criado_em                 DateTime       @default(now()) @db.Timestamptz(3)
  atualizado_em             DateTime       @updatedAt @db.Timestamptz(3)

  usuario               Usuario               @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  tipo_carteira         TipoCarteira          @relation(fields: [tipo_carteira_id], references: [id], onDelete: Restrict)
  lancamentos           LancamentoCarteira[]
  saques                Saque[]
  composicoes_pagamento PagamentoComposicao[]

  @@unique([usuario_id, tipo_carteira_id])
  @@index([usuario_id])
  @@index([tipo_carteira_id])
  @@index([status])
  @@map("carteiras")
}

model LancamentoCarteira {
  id                       Int                      @id @default(autoincrement())
  carteira_id              Int
  usuario_id               Int
  tipo_lancamento          TipoLancamentoCarteira
  origem                   OrigemLancamentoCarteira
  origem_id                Int?
  valor_centavos           BigInt                   @db.BigInt
  saldo_anterior_centavos  BigInt                   @db.BigInt
  saldo_posterior_centavos BigInt                   @db.BigInt
  status                   StatusLancamentoCarteira @default(PENDENTE)
  descricao                String?
  liberado_em              DateTime?                @db.Timestamptz(3)
  bloqueado_em             DateTime?                @db.Timestamptz(3)
  estornado_em             DateTime?                @db.Timestamptz(3)
  criado_em                DateTime                 @default(now()) @db.Timestamptz(3)
  atualizado_em            DateTime                 @updatedAt @db.Timestamptz(3)

  carteira Carteira @relation(fields: [carteira_id], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  @@index([carteira_id])
  @@index([usuario_id])
  @@index([tipo_lancamento])
  @@index([origem])
  @@index([origem_id])
  @@index([status])
  @@index([criado_em])
  @@map("lancamentos_carteira")
}

model Pagamento {
  id                            Int              @id @default(autoincrement())
  usuario_pagador_id            Int
  loja_id                       Int?
  vendedor_id                   Int?
  valor_total_centavos          BigInt           @db.BigInt
  valor_pago_pix_centavos       BigInt           @default(0) @db.BigInt
  valor_pago_cartao_centavos    BigInt           @default(0) @db.BigInt
  valor_pago_saldo_centavos     BigInt           @default(0) @db.BigInt
  valor_cashback_usado_centavos BigInt           @default(0) @db.BigInt
  metodo_principal              MetodoPagamento
  status                        StatusPagamento  @default(PENDENTE)
  gateway                       GatewayPagamento @default(INTERNO)
  gateway_pagamento_id          String?          @db.VarChar(255)
  qr_code                       String?
  copia_cola_pix                String?
  expira_em                     DateTime?        @db.Timestamptz(3)
  pago_em                       DateTime?        @db.Timestamptz(3)
  cancelado_em                  DateTime?        @db.Timestamptz(3)
  estornado_em                  DateTime?        @db.Timestamptz(3)
  criado_em                     DateTime         @default(now()) @db.Timestamptz(3)
  atualizado_em                 DateTime         @updatedAt @db.Timestamptz(3)

  usuario_pagador     Usuario                  @relation("UsuarioPagador", fields: [usuario_pagador_id], references: [id], onDelete: Restrict)
  loja                Loja?                    @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  vendedor            Vendedor?                @relation(fields: [vendedor_id], references: [id], onDelete: Restrict)
  itens               PagamentoItem[]
  composicoes         PagamentoComposicao[]
  transacao_comercial TransacaoComercial?
  pedido_loja         PedidoLoja?
  cobranca            Cobranca?
  comprovantes        ComprovantePagamento[]
  eventos_financeiros EventoFinanceiro[]
  eventos_gateway     EventoGatewayPagamento[]

  @@unique([gateway, gateway_pagamento_id])
  @@index([usuario_pagador_id])
  @@index([loja_id])
  @@index([vendedor_id])
  @@index([status])
  @@index([gateway])
  @@index([gateway_pagamento_id])
  @@index([criado_em])
  @@map("pagamentos")
}

model EventoGatewayPagamento {
  id                 Int              @id @default(autoincrement())
  gateway            GatewayPagamento
  gateway_evento_id  String           @unique @db.VarChar(255)
  tipo_evento        String           @db.VarChar(120)
  pagamento_id       Int?
  payload_json       Json
  processado_em      DateTime?        @db.Timestamptz(3)
  erro_processamento String?
  criado_em          DateTime         @default(now()) @db.Timestamptz(3)
  atualizado_em      DateTime         @updatedAt @db.Timestamptz(3)

  pagamento Pagamento? @relation(fields: [pagamento_id], references: [id], onDelete: SetNull)

  @@index([gateway])
  @@index([pagamento_id])
  @@index([tipo_evento])
  @@index([criado_em])
  @@map("eventos_gateway_pagamento")
}

model Cobranca {
  id                  Int            @id @default(autoincrement())
  codigo_publico      String         @unique @db.VarChar(64)
  criador_usuario_id  Int
  loja_id             Int?
  vendedor_id         Int?
  venda_autonoma_id   Int?           @unique
  proposta_servico_id Int?           @unique
  pagamento_id        Int?           @unique
  origem              OrigemCobranca
  titulo              String         @db.VarChar(180)
  descricao           String?
  valor_centavos      BigInt         @db.BigInt
  status              StatusCobranca @default(ATIVA)
  expira_em           DateTime?      @db.Timestamptz(3)
  paga_em             DateTime?      @db.Timestamptz(3)
  cancelada_em        DateTime?      @db.Timestamptz(3)
  criado_em           DateTime       @default(now()) @db.Timestamptz(3)
  atualizado_em       DateTime       @updatedAt @db.Timestamptz(3)

  criador          Usuario          @relation("CobrancaCriador", fields: [criador_usuario_id], references: [id], onDelete: Restrict)
  loja             Loja?            @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  vendedor         Vendedor?        @relation(fields: [vendedor_id], references: [id], onDelete: Restrict)
  venda_autonoma   VendaAutonoma?   @relation(fields: [venda_autonoma_id], references: [id], onDelete: SetNull)
  proposta_servico PropostaServico? @relation(fields: [proposta_servico_id], references: [id], onDelete: SetNull)
  pagamento        Pagamento?       @relation(fields: [pagamento_id], references: [id], onDelete: SetNull)

  @@index([criador_usuario_id])
  @@index([loja_id])
  @@index([vendedor_id])
  @@index([proposta_servico_id])
  @@index([status])
  @@index([expira_em])
  @@index([criado_em])
  @@map("cobrancas")
}

model PagamentoItem {
  id                      Int               @id @default(autoincrement())
  pagamento_id            Int
  nome_item               String            @db.VarChar(180)
  descricao               String?
  quantidade              Int               @default(1)
  valor_unitario_centavos BigInt            @db.BigInt
  valor_total_centavos    BigInt            @db.BigInt
  tipo_item               TipoItemPagamento
  referencia_id           String?           @db.VarChar(80)
  criado_em               DateTime          @default(now()) @db.Timestamptz(3)
  atualizado_em           DateTime          @updatedAt @db.Timestamptz(3)

  pagamento Pagamento @relation(fields: [pagamento_id], references: [id], onDelete: Cascade)

  @@index([pagamento_id])
  @@index([tipo_item])
  @@index([referencia_id])
  @@map("itens_pagamento")
}

model PagamentoComposicao {
  id             Int                       @id @default(autoincrement())
  pagamento_id   Int
  tipo_origem    TipoOrigemPagamento
  carteira_id    Int?
  valor_centavos BigInt                    @db.BigInt
  status         StatusPagamentoComposicao @default(PENDENTE)
  criado_em      DateTime                  @default(now()) @db.Timestamptz(3)
  atualizado_em  DateTime                  @updatedAt @db.Timestamptz(3)

  pagamento Pagamento @relation(fields: [pagamento_id], references: [id], onDelete: Cascade)
  carteira  Carteira? @relation(fields: [carteira_id], references: [id], onDelete: Restrict)

  @@index([pagamento_id])
  @@index([carteira_id])
  @@index([tipo_origem])
  @@index([status])
  @@map("composicoes_pagamento")
}

model PedidoLoja {
  id                             Int               @id @default(autoincrement())
  codigo                         String            @unique @db.VarChar(30)
  usuario_id                     Int
  loja_id                        Int
  pagamento_id                   Int?              @unique
  chave_idempotencia             String?           @db.VarChar(120)
  endereco_entrega_id            Int?
  tipo_entrega                   TipoEntregaPedido
  status                         StatusPedidoLoja  @default(RECEBIDO)
  subtotal_centavos              BigInt            @db.BigInt
  taxa_entrega_centavos          BigInt            @default(0) @db.BigInt
  total_centavos                 BigInt            @db.BigInt
  valor_pago_saldo_centavos      BigInt            @default(0) @db.BigInt
  valor_pago_pix_centavos        BigInt            @default(0) @db.BigInt
  observacao_cliente             String?
  endereco_entrega_snapshot_json Json?
  aceito_em                      DateTime?         @db.Timestamptz(3)
  preparando_em                  DateTime?         @db.Timestamptz(3)
  saiu_entrega_em                DateTime?         @db.Timestamptz(3)
  pronto_retirada_em             DateTime?         @db.Timestamptz(3)
  concluido_em                   DateTime?         @db.Timestamptz(3)
  cancelado_em                   DateTime?         @db.Timestamptz(3)
  estoque_reservado_em           DateTime?         @db.Timestamptz(3)
  estoque_liberado_em            DateTime?         @db.Timestamptz(3)
  criado_em                      DateTime          @default(now()) @db.Timestamptz(3)
  atualizado_em                  DateTime          @updatedAt @db.Timestamptz(3)

  comprador            Usuario              @relation("UsuarioPedidosLoja", fields: [usuario_id], references: [id], onDelete: Restrict)
  loja                 Loja                 @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  pagamento            Pagamento?           @relation(fields: [pagamento_id], references: [id], onDelete: Restrict)
  endereco_entrega     EnderecoUsuario?     @relation(fields: [endereco_entrega_id], references: [id], onDelete: SetNull)
  itens                PedidoLojaItem[]
  mensagens            PedidoLojaMensagem[]
  propostas            PropostaPedidoLoja[]
  corridas_motoboy     ConversaServico[]    @relation("PedidoCorridasMotoboy")
  solicitacoes_motoboy SolicitacaoMotoboy[] @relation("PedidoSolicitacoesMotoboy")

  @@unique([usuario_id, chave_idempotencia])
  @@index([usuario_id])
  @@index([loja_id])
  @@index([endereco_entrega_id])
  @@index([status])
  @@index([tipo_entrega])
  @@index([criado_em])
  @@map("pedidos_loja")
}

model PropostaPedidoLoja {
  id               Int                      @id @default(autoincrement())
  pedido_id        Int
  autor_usuario_id Int
  valor_centavos   BigInt                   @db.BigInt
  descricao        String?
  status           StatusPropostaPedidoLoja @default(PENDENTE)
  respondido_em    DateTime?                @db.Timestamptz(3)
  pago_em          DateTime?                @db.Timestamptz(3)
  criado_em        DateTime                 @default(now()) @db.Timestamptz(3)
  atualizado_em    DateTime                 @updatedAt @db.Timestamptz(3)

  pedido PedidoLoja @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  autor  Usuario    @relation("UsuarioPropostasPedidoLoja", fields: [autor_usuario_id], references: [id], onDelete: Restrict)

  @@index([pedido_id, criado_em])
  @@index([autor_usuario_id])
  @@index([status])
  @@map("propostas_pedido_loja")
}

model PedidoLojaItem {
  id                      Int      @id @default(autoincrement())
  pedido_id               Int
  produto_id              Int?
  nome_produto            String   @db.VarChar(180)
  descricao               String?
  quantidade              Int      @default(1)
  valor_unitario_centavos BigInt   @db.BigInt
  valor_total_centavos    BigInt   @db.BigInt
  observacao              String?
  criado_em               DateTime @default(now()) @db.Timestamptz(3)
  atualizado_em           DateTime @updatedAt @db.Timestamptz(3)

  pedido  PedidoLoja   @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto ProdutoLoja? @relation(fields: [produto_id], references: [id], onDelete: SetNull)

  @@index([pedido_id])
  @@index([produto_id])
  @@map("itens_pedido_loja")
}

model PedidoLojaMensagem {
  id               Int                      @id @default(autoincrement())
  pedido_id        Int
  autor_usuario_id Int?
  origem           OrigemMensagemPedidoLoja
  titulo           String?                  @db.VarChar(120)
  mensagem         String                   @db.Text
  metadata_json    Json?
  lido_cliente_em  DateTime?                @db.Timestamptz(3)
  lido_loja_em     DateTime?                @db.Timestamptz(3)
  criado_em        DateTime                 @default(now()) @db.Timestamptz(3)
  atualizado_em    DateTime                 @updatedAt @db.Timestamptz(3)

  pedido PedidoLoja @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  autor  Usuario?   @relation(fields: [autor_usuario_id], references: [id], onDelete: SetNull)

  @@index([pedido_id, criado_em])
  @@index([autor_usuario_id])
  @@index([origem])
  @@map("mensagens_pedido_loja")
}

model TransacaoComercial {
  id                              Int                      @id @default(autoincrement())
  pagamento_id                    Int                      @unique
  comprador_usuario_id            Int
  loja_id                         Int?
  lojista_id                      Int?
  vendedor_id                     Int?
  valor_bruto_centavos            BigInt                   @db.BigInt
  taxa_plataforma_centavos        BigInt                   @default(0) @db.BigInt
  valor_liquido_lojista_centavos  BigInt                   @default(0) @db.BigInt
  valor_pool_recompensas_centavos BigInt                   @default(0) @db.BigInt
  valor_empresa_centavos          BigInt                   @default(0) @db.BigInt
  percentual_taxa_plataforma      Decimal                  @default(0) @db.Decimal(7, 4)
  percentual_empresa              Decimal                  @default(0) @db.Decimal(7, 4)
  percentual_pool                 Decimal                  @default(0) @db.Decimal(7, 4)
  status                          StatusTransacaoComercial @default(PENDENTE)
  validada_em                     DateTime?                @db.Timestamptz(3)
  liquidada_em                    DateTime?                @db.Timestamptz(3)
  cancelada_em                    DateTime?                @db.Timestamptz(3)
  estornada_em                    DateTime?                @db.Timestamptz(3)
  criado_em                       DateTime                 @default(now()) @db.Timestamptz(3)
  atualizado_em                   DateTime                 @updatedAt @db.Timestamptz(3)

  pagamento              Pagamento              @relation(fields: [pagamento_id], references: [id], onDelete: Restrict)
  comprador              Usuario                @relation("UsuarioComprador", fields: [comprador_usuario_id], references: [id], onDelete: Restrict)
  loja                   Loja?                  @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  lojista                Lojista?               @relation(fields: [lojista_id], references: [id], onDelete: Restrict)
  vendedor               Vendedor?              @relation(fields: [vendedor_id], references: [id], onDelete: Restrict)
  recebiveis             Recebivel[]
  recompensas            Recompensa[]
  lancamentos_plataforma LancamentoPlataforma[]
  eventos_financeiros    EventoFinanceiro[]
  documento_fiscal       DocumentoFiscal?

  @@index([comprador_usuario_id])
  @@index([loja_id])
  @@index([lojista_id])
  @@index([vendedor_id])
  @@index([status])
  @@index([criado_em])
  @@index([liquidada_em])
  @@map("transacoes_comerciais")
}

model Recebivel {
  id                       Int             @id @default(autoincrement())
  transacao_comercial_id   Int
  usuario_recebedor_id     Int
  loja_id                  Int?
  tipo_recebedor           TipoRecebedor
  valor_bruto_centavos     BigInt          @db.BigInt
  taxa_plataforma_centavos BigInt          @default(0) @db.BigInt
  valor_liquido_centavos   BigInt          @db.BigInt
  status                   StatusRecebivel @default(PENDENTE)
  disponivel_em            DateTime?       @db.Timestamptz(3)
  pago_em                  DateTime?       @db.Timestamptz(3)
  bloqueado_em             DateTime?       @db.Timestamptz(3)
  motivo_bloqueio          String?
  criado_em                DateTime        @default(now()) @db.Timestamptz(3)
  atualizado_em            DateTime        @updatedAt @db.Timestamptz(3)

  transacao_comercial TransacaoComercial @relation(fields: [transacao_comercial_id], references: [id], onDelete: Restrict)
  usuario_recebedor   Usuario            @relation("UsuarioRecebedor", fields: [usuario_recebedor_id], references: [id], onDelete: Restrict)
  loja                Loja?              @relation(fields: [loja_id], references: [id], onDelete: Restrict)

  @@unique([transacao_comercial_id, usuario_recebedor_id, tipo_recebedor])
  @@index([transacao_comercial_id])
  @@index([usuario_recebedor_id])
  @@index([loja_id])
  @@index([tipo_recebedor])
  @@index([status])
  @@index([disponivel_em])
  @@map("recebiveis")
}

model Recompensa {
  id                     Int              @id @default(autoincrement())
  transacao_comercial_id Int
  usuario_beneficiado_id Int
  tipo_recompensa        TipoRecompensa
  valor_centavos         BigInt           @db.BigInt
  percentual             Decimal?         @db.Decimal(7, 4)
  status                 StatusRecompensa @default(PENDENTE)
  motivo                 String?
  liberado_em            DateTime?        @db.Timestamptz(3)
  estornado_em           DateTime?        @db.Timestamptz(3)
  criado_em              DateTime         @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime         @updatedAt @db.Timestamptz(3)

  transacao_comercial TransacaoComercial @relation(fields: [transacao_comercial_id], references: [id], onDelete: Restrict)
  usuario_beneficiado Usuario            @relation("UsuarioBeneficiado", fields: [usuario_beneficiado_id], references: [id], onDelete: Restrict)

  @@unique([transacao_comercial_id, usuario_beneficiado_id, tipo_recompensa])
  @@index([transacao_comercial_id])
  @@index([usuario_beneficiado_id])
  @@index([tipo_recompensa])
  @@index([status])
  @@index([criado_em])
  @@map("recompensas")
}

model RegraRecompensa {
  id                     Int            @id @default(autoincrement())
  nome                   String         @db.VarChar(180)
  tipo_recompensa        TipoRecompensa
  percentual             Decimal?       @db.Decimal(7, 4)
  valor_fixo_centavos    BigInt?        @db.BigInt
  limite_maximo_centavos BigInt?        @db.BigInt
  ativo                  Boolean        @default(true)
  inicio_em              DateTime?      @db.Timestamptz(3)
  fim_em                 DateTime?      @db.Timestamptz(3)
  criado_em              DateTime       @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime       @updatedAt @db.Timestamptz(3)

  @@index([tipo_recompensa])
  @@index([ativo])
  @@index([inicio_em])
  @@index([fim_em])
  @@map("regras_recompensa")
}

model CampanhaCashback {
  id                             Int                    @id @default(autoincrement())
  loja_id                        Int?
  nome                           String                 @db.VarChar(180)
  descricao                      String?
  percentual_cashback            Decimal                @db.Decimal(7, 4)
  valor_maximo_cashback_centavos BigInt?                @db.BigInt
  orcamento_total_centavos       BigInt                 @db.BigInt
  orcamento_usado_centavos       BigInt                 @default(0) @db.BigInt
  inicio_em                      DateTime               @db.Timestamptz(3)
  fim_em                         DateTime               @db.Timestamptz(3)
  status                         StatusCampanhaCashback @default(RASCUNHO)
  criado_em                      DateTime               @default(now()) @db.Timestamptz(3)
  atualizado_em                  DateTime               @updatedAt @db.Timestamptz(3)

  loja Loja? @relation(fields: [loja_id], references: [id], onDelete: Cascade)

  @@index([loja_id])
  @@index([status])
  @@index([inicio_em])
  @@index([fim_em])
  @@map("campanhas_cashback")
}

model Saque {
  id                     Int         @id @default(autoincrement())
  usuario_id             Int
  carteira_id            Int
  conta_bancaria_id      Int
  valor_centavos         BigInt      @db.BigInt
  taxa_saque_centavos    BigInt      @default(0) @db.BigInt
  valor_liquido_centavos BigInt      @db.BigInt
  status                 StatusSaque @default(SOLICITADO)
  gateway_saque_id       String?     @db.VarChar(255)
  solicitado_em          DateTime    @default(now()) @db.Timestamptz(3)
  processado_em          DateTime?   @db.Timestamptz(3)
  cancelado_em           DateTime?   @db.Timestamptz(3)
  motivo_cancelamento    String?
  criado_em              DateTime    @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime    @updatedAt @db.Timestamptz(3)

  usuario        Usuario       @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  carteira       Carteira      @relation(fields: [carteira_id], references: [id], onDelete: Restrict)
  conta_bancaria ContaBancaria @relation(fields: [conta_bancaria_id], references: [id], onDelete: Restrict)

  @@index([usuario_id])
  @@index([carteira_id])
  @@index([conta_bancaria_id])
  @@index([status])
  @@index([solicitado_em])
  @@map("saques")
}

model TaxaPlataforma {
  id                          Int                  @id @default(autoincrement())
  nome                        String               @db.VarChar(180)
  tipo_taxa                   TipoTaxaPlataforma
  categoria_loja_id           Int?
  loja_id                     Int?
  percentual_taxa             Decimal?             @db.Decimal(7, 4)
  valor_fixo_centavos         BigInt?              @db.BigInt
  percentual_empresa          Decimal?             @db.Decimal(7, 4)
  percentual_pool_recompensas Decimal?             @db.Decimal(7, 4)
  status                      StatusTaxaPlataforma @default(ATIVA)
  inicio_em                   DateTime?            @db.Timestamptz(3)
  fim_em                      DateTime?            @db.Timestamptz(3)
  criado_em                   DateTime             @default(now()) @db.Timestamptz(3)
  atualizado_em               DateTime             @updatedAt @db.Timestamptz(3)

  categoria_loja CategoriaLoja? @relation(fields: [categoria_loja_id], references: [id], onDelete: Cascade)
  loja           Loja?          @relation(fields: [loja_id], references: [id], onDelete: Cascade)

  @@index([tipo_taxa])
  @@index([categoria_loja_id])
  @@index([loja_id])
  @@index([status])
  @@index([inicio_em])
  @@index([fim_em])
  @@map("taxas_plataforma")
}

model ContaPlataforma {
  id             Int                   @id @default(autoincrement())
  nome           String                @db.VarChar(180)
  tipo_conta     TipoContaPlataforma
  saldo_centavos BigInt                @default(0) @db.BigInt
  status         StatusContaPlataforma @default(ATIVA)
  criado_em      DateTime              @default(now()) @db.Timestamptz(3)
  atualizado_em  DateTime              @updatedAt @db.Timestamptz(3)

  lancamentos LancamentoPlataforma[]

  @@unique([tipo_conta])
  @@index([tipo_conta])
  @@index([status])
  @@map("contas_plataforma")
}

model LancamentoPlataforma {
  id                     Int                        @id @default(autoincrement())
  conta_plataforma_id    Int
  transacao_comercial_id Int?
  tipo_lancamento        TipoLancamentoPlataforma
  valor_centavos         BigInt                     @db.BigInt
  descricao              String?
  status                 StatusLancamentoPlataforma @default(PENDENTE)
  criado_em              DateTime                   @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime                   @updatedAt @db.Timestamptz(3)

  conta_plataforma    ContaPlataforma     @relation(fields: [conta_plataforma_id], references: [id], onDelete: Restrict)
  transacao_comercial TransacaoComercial? @relation(fields: [transacao_comercial_id], references: [id], onDelete: Restrict)

  @@index([conta_plataforma_id])
  @@index([transacao_comercial_id])
  @@index([tipo_lancamento])
  @@index([status])
  @@index([criado_em])
  @@map("lancamentos_plataforma")
}

model ComprovantePagamento {
  id               Int             @id @default(autoincrement())
  pagamento_id     Int
  url_comprovante  String
  tipo_comprovante TipoComprovante
  criado_em        DateTime        @default(now()) @db.Timestamptz(3)
  atualizado_em    DateTime        @updatedAt @db.Timestamptz(3)

  pagamento Pagamento @relation(fields: [pagamento_id], references: [id], onDelete: Cascade)

  @@index([pagamento_id])
  @@index([tipo_comprovante])
  @@map("comprovantes_pagamento")
}

model DocumentoFiscal {
  id                     Int                   @id @default(autoincrement())
  loja_id                Int
  transacao_comercial_id Int?                  @unique
  tipo_documento         TipoDocumentoFiscal
  numero                 String?               @db.VarChar(60)
  serie                  String?               @db.VarChar(30)
  chave_acesso           String?               @db.VarChar(80)
  url_pdf                String?
  status                 StatusDocumentoFiscal @default(PENDENTE)
  emitido_em             DateTime?             @db.Timestamptz(3)
  criado_em              DateTime              @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime              @updatedAt @db.Timestamptz(3)

  loja                Loja                @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  transacao_comercial TransacaoComercial? @relation(fields: [transacao_comercial_id], references: [id], onDelete: Restrict)

  @@index([loja_id])
  @@index([transacao_comercial_id])
  @@index([chave_acesso])
  @@index([status])
  @@index([emitido_em])
  @@map("documentos_fiscais")
}

model EventoFinanceiro {
  id                     Int                  @id @default(autoincrement())
  usuario_id             Int?
  transacao_comercial_id Int?
  pagamento_id           Int?
  tipo_evento            TipoEventoFinanceiro
  descricao              String?
  dados_json             Json?
  criado_em              DateTime             @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime             @updatedAt @db.Timestamptz(3)

  usuario             Usuario?            @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  transacao_comercial TransacaoComercial? @relation(fields: [transacao_comercial_id], references: [id], onDelete: Restrict)
  pagamento           Pagamento?          @relation(fields: [pagamento_id], references: [id], onDelete: Restrict)

  @@index([usuario_id])
  @@index([transacao_comercial_id])
  @@index([pagamento_id])
  @@index([tipo_evento])
  @@index([criado_em])
  @@map("eventos_financeiros")
}
