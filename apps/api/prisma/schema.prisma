model Administrador {
  id              Int                 @id @default(autoincrement())
  nome            String              @db.VarChar(160)
  email           String              @unique @db.VarChar(255)
  telefone        String?             @unique @db.VarChar(30)
  senha_hash      String              @db.VarChar(255)
  papel           PapelAdministrador  @default(ADMIN)
  status          StatusAdministrador @default(ATIVO)
  ultimo_login_em DateTime?           @db.Timestamptz(3)
  criado_em       DateTime            @default(now()) @db.Timestamptz(3)
  atualizado_em   DateTime            @updatedAt @db.Timestamptz(3)
  excluido_em     DateTime?           @db.Timestamptz(3)

  sessoes_autenticacao SessaoAutenticacao[]

  @@index([status])
  @@index([papel])
  @@map("administradores")
}

model ConfiguracaoSistema {
  id                      Int      @id @default(autoincrement())
  chave                   String   @unique @db.VarChar(120)
  valor_json              Json
  descricao               String?
  atualizado_por_admin_id Int?
  criado_em               DateTime @default(now()) @db.Timestamptz(3)
  atualizado_em           DateTime @updatedAt @db.Timestamptz(3)

  @@index([atualizado_por_admin_id])
  @@map("configuracoes_sistema")
}

model Usuario {
  id                      Int              @id @default(autoincrement())
  nome                    String           @db.VarChar(160)
  email                   String           @unique @db.VarChar(255)
  telefone                String?          @unique @db.VarChar(30)
  cpf                     String?          @unique @db.VarChar(14)
  senha_hash              String           @db.VarChar(255)
  data_nascimento         DateTime?        @db.Date
  foto_url                String?
  status                  StatusUsuario    @default(PENDENTE)
  tipo_conta              TipoContaUsuario @default(CONSUMIDOR)
  nivel_kyc               NivelKyc         @default(TIER_1)
  loja_origem_cadastro_id Int?
  asaas_cliente_id        String?          @unique @db.VarChar(255)
  email_verificado        Boolean          @default(false)
  telefone_verificado     Boolean          @default(false)
  ultimo_login_em         DateTime?        @db.Timestamptz(3)
  criado_em               DateTime         @default(now()) @db.Timestamptz(3)
  atualizado_em           DateTime         @updatedAt @db.Timestamptz(3)
  excluido_em             DateTime?        @db.Timestamptz(3)

  enderecos                  EnderecoUsuario[]
  kyc                        KycUsuario?
  contas_bancarias           ContaBancaria[]
  carteiras                  Carteira[]
  codigos_convite            CodigoConvite[]
  indicacoes_feitas          Indicacao[]               @relation("UsuarioIndicador")
  indicacao_recebida         Indicacao?                @relation("UsuarioIndicado")
  alocacoes_matriz           Indicacao[]               @relation("UsuarioAlocador")
  pagamentos                 Pagamento[]               @relation("UsuarioPagador")
  cobrancas_criadas          Cobranca[]                @relation("CobrancaCriador")
  pedidos_loja               PedidoLoja[]              @relation("UsuarioPedidosLoja")
  mensagens_pedido_loja      PedidoLojaMensagem[]
  propostas_pedido_loja      PropostaPedidoLoja[]      @relation("UsuarioPropostasPedidoLoja")
  conversas_servico_cliente  ConversaServico[]         @relation("ConversaServicoCliente")
  solicitacoes_motoboy       SolicitacaoMotoboy[]      @relation("UsuarioSolicitacoesMotoboy")
  mensagens_conversa_servico ConversaServicoMensagem[]
  conversas_loja_cliente     ConversaLoja[]            @relation("ConversaLojaCliente")
  mensagens_conversa_loja    ConversaLojaMensagem[]    @relation("ConversaLojaMensagemAutor")
  saques                     Saque[]
  recompensas                Recompensa[]              @relation("UsuarioBeneficiado")
  lancamentos_carteira       LancamentoCarteira[]
  vendedor                   Vendedor?
  lojista                    Lojista?
  lojas_vinculadas           UsuarioLoja[]
  transacoes_compradas       TransacaoComercial[]      @relation("UsuarioComprador")
  recebiveis                 Recebivel[]               @relation("UsuarioRecebedor")
  eventos_financeiros        EventoFinanceiro[]
  identidades_sociais        IdentidadeSocialUsuario[]
  sessoes_autenticacao       SessaoAutenticacao[]
  loja_origem_cadastro       Loja?                     @relation("UsuariosCadastroOrigemLoja", fields: [loja_origem_cadastro_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([tipo_conta])
  @@index([nivel_kyc])
  @@index([loja_origem_cadastro_id])
  @@map("usuarios")
}

model SessaoAutenticacao {
  id               Int       @id @default(autoincrement())
  jti              String    @unique @db.VarChar(100)
  usuario_id       Int?
  administrador_id Int?
  audiencia        String    @db.VarChar(40)
  expira_em        DateTime  @db.Timestamptz(3)
  revogada_em      DateTime? @db.Timestamptz(3)
  rotacionada_em   DateTime? @db.Timestamptz(3)
  criado_em        DateTime  @default(now()) @db.Timestamptz(3)
  atualizado_em    DateTime  @updatedAt @db.Timestamptz(3)

  usuario       Usuario?       @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  administrador Administrador? @relation(fields: [administrador_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, audiencia])
  @@index([administrador_id, audiencia])
  @@index([expira_em])
  @@index([revogada_em])
  @@map("sessoes_autenticacao")
}

model IdentidadeSocialUsuario {
  id                  Int                 @id @default(autoincrement())
  usuario_id          Int
  provedor            ProvedorLoginSocial
  provedor_usuario_id String              @db.VarChar(255)
  email_provedor      String?             @db.VarChar(255)
  criado_em           DateTime            @default(now()) @db.Timestamptz(3)
  atualizado_em       DateTime            @updatedAt @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([provedor, provedor_usuario_id])
  @@unique([usuario_id, provedor])
  @@index([usuario_id])
  @@map("identidades_sociais_usuario")
}

model EnderecoUsuario {
  id            Int       @id @default(autoincrement())
  usuario_id    Int
  nome_endereco String?   @db.VarChar(80)
  cep           String    @db.VarChar(9)
  estado        String    @db.Char(2)
  cidade        String    @db.VarChar(120)
  bairro        String    @db.VarChar(120)
  rua           String    @db.VarChar(180)
  numero        String    @db.VarChar(30)
  complemento   String?   @db.VarChar(180)
  referencia    String?   @db.VarChar(255)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  principal     Boolean   @default(false)
  criado_em     DateTime  @default(now()) @db.Timestamptz(3)
  atualizado_em DateTime  @updatedAt @db.Timestamptz(3)
  excluido_em   DateTime? @db.Timestamptz(3)

  usuario         Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  pedidos_entrega PedidoLoja[]

  @@index([usuario_id])
  @@index([cidade])
  @@index([estado])
  @@index([principal])
  @@map("enderecos_usuario")
}

model KycUsuario {
  id                   Int        @id @default(autoincrement())
  usuario_id           Int        @unique
  tipo_pessoa          TipoPessoa
  cpf                  String?    @db.VarChar(14)
  cnpj                 String?    @db.VarChar(18)
  nome_completo        String?    @db.VarChar(180)
  razao_social         String?    @db.VarChar(180)
  nome_fantasia        String?    @db.VarChar(180)
  documento_frente_url String?
  documento_verso_url  String?
  selfie_url           String?
  status               StatusKyc  @default(PENDENTE)
  motivo_reprovacao    String?
  validado_em          DateTime?  @db.Timestamptz(3)
  criado_em            DateTime   @default(now()) @db.Timestamptz(3)
  atualizado_em        DateTime   @updatedAt @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([cpf])
  @@index([cnpj])
  @@index([status])
  @@map("kyc_usuarios")
}

model ContaBancaria {
  id                Int                 @id @default(autoincrement())
  usuario_id        Int
  tipo_chave        TipoChavePix?
  chave_pix         String?             @db.VarChar(255)
  banco             String?             @db.VarChar(120)
  agencia           String?             @db.VarChar(20)
  conta             String?             @db.VarChar(30)
  tipo_conta        TipoContaBancaria?
  nome_titular      String              @db.VarChar(180)
  documento_titular String              @db.VarChar(18)
  status            StatusContaBancaria @default(PENDENTE)
  principal         Boolean             @default(false)
  criado_em         DateTime            @default(now()) @db.Timestamptz(3)
  atualizado_em     DateTime            @updatedAt @db.Timestamptz(3)
  excluido_em       DateTime?           @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  saques  Saque[]

  @@index([usuario_id])
  @@index([chave_pix])
  @@index([documento_titular])
  @@index([status])
  @@index([principal])
  @@map("contas_bancarias")
}

model CodigoConvite {
  id            Int       @id @default(autoincrement())
  usuario_id    Int
  codigo        String    @unique @db.VarChar(40)
  ativo         Boolean   @default(true)
  usos_totais   Int       @default(0)
  criado_em     DateTime  @default(now()) @db.Timestamptz(3)
  atualizado_em DateTime  @updatedAt @db.Timestamptz(3)
  expira_em     DateTime? @db.Timestamptz(3)

  usuario    Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  indicacoes Indicacao[]

  @@index([usuario_id])
  @@index([ativo])
  @@map("codigos_convite")
}

model Indicacao {
  id                     Int             @id @default(autoincrement())
  indicador_usuario_id   Int
  indicado_usuario_id    Int             @unique
  alocado_sob_usuario_id Int?
  posicao_matriz         Int?
  nivel_matriz           Int?
  codigo_convite_id      Int?
  tipo_indicacao         TipoIndicacao
  origem                 String?         @db.VarChar(120)
  status                 StatusIndicacao @default(PENDENTE)
  primeira_compra_em     DateTime?       @db.Timestamptz(3)
  primeira_venda_em      DateTime?       @db.Timestamptz(3)
  criado_em              DateTime        @default(now()) @db.Timestamptz(3)
  atualizado_em          DateTime        @updatedAt @db.Timestamptz(3)

  indicador      Usuario        @relation("UsuarioIndicador", fields: [indicador_usuario_id], references: [id], onDelete: Restrict)
  indicado       Usuario        @relation("UsuarioIndicado", fields: [indicado_usuario_id], references: [id], onDelete: Restrict)
  alocado_sob    Usuario?       @relation("UsuarioAlocador", fields: [alocado_sob_usuario_id], references: [id], onDelete: Restrict)
  codigo_convite CodigoConvite? @relation(fields: [codigo_convite_id], references: [id], onDelete: SetNull)

  @@unique([alocado_sob_usuario_id, posicao_matriz])
  @@index([indicador_usuario_id])
  @@index([indicado_usuario_id])
  @@index([alocado_sob_usuario_id])
  @@index([nivel_matriz])
  @@index([codigo_convite_id])
  @@index([tipo_indicacao])
  @@index([status])
  @@map("indicacoes")
}

model Lojista {
  id                                 Int           @id @default(autoincrement())
  usuario_id                         Int           @unique
  tipo_pessoa                        TipoPessoa
  cpf                                String?       @db.VarChar(14)
  cnpj                               String?       @db.VarChar(18)
  razao_social                       String?       @db.VarChar(180)
  nome_fantasia                      String?       @db.VarChar(180)
  status_kyc                         StatusKyc     @default(PENDENTE)
  status                             StatusLojista @default(PENDENTE)
  limite_faturamento_mensal_centavos BigInt?       @db.BigInt
  criado_em                          DateTime      @default(now()) @db.Timestamptz(3)
  atualizado_em                      DateTime      @updatedAt @db.Timestamptz(3)
  excluido_em                        DateTime?     @db.Timestamptz(3)

  usuario    Usuario              @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  lojas      Loja[]
  transacoes TransacaoComercial[]

  @@unique([cpf])
  @@unique([cnpj])
  @@index([status])
  @@index([status_kyc])
  @@map("lojistas")
}

model CategoriaLoja {
  id                            Int                 @id @default(autoincrement())
  // Compatibilidade temporaria: a relacao definitiva fica em SegmentoVenda.categoria_loja_id.
  segmento_venda_id             Int?
  nome                          String              @db.VarChar(120)
  descricao                     String?
  icone_url                     String?
  negocia_pedido_por_chat       Boolean             @default(false)
  status                        StatusCategoriaLoja @default(ATIVA)
  taxa_plataforma_percentual    Decimal             @default(0) @db.Decimal(7, 4)
  taxa_plataforma_atualizada_em DateTime?           @db.Timestamptz(3)
  criado_em                     DateTime            @default(now()) @db.Timestamptz(3)
  atualizado_em                 DateTime            @updatedAt @db.Timestamptz(3)
  excluido_em                   DateTime?           @db.Timestamptz(3)

  lojas           Loja[]
  segmento_venda  SegmentoVenda?   @relation("SegmentoCategoriasLojaLegado", fields: [segmento_venda_id], references: [id], onDelete: SetNull)
  segmentos_venda SegmentoVenda[]  @relation("CategoriaSegmentosVenda")
  taxas           TaxaPlataforma[]

  @@index([nome])
  @@index([segmento_venda_id])
  @@index([status])
  @@map("categorias_loja")
}

