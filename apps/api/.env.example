PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082
DATABASE_URL=postgresql://admin:adimin@localhost:5432/meu_banco?schema=public

# Redis centraliza cache, rate limit e eventos Socket.IO entre instancias da API.
# Para usar a API fora do Docker local: redis://localhost:6379
# Em producao, REDIS_REQUIRED deve ficar true.
REDIS_URL=
REDIS_REQUIRED=false

# Monitoramento: o token protege /health/operations e /health/metrics.
# ALERT_WEBHOOK_URL pode apontar para Slack, Discord ou outro endpoint HTTP.
MONITORING_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic
ALERT_COOLDOWN_MS=300000

# Notificacoes nativas Expo. O app continua usando Socket.IO quando esta aberto.
# Ative somente apos criar o projeto EAS e configurar iOS/Android.
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=

# Links usados no QR de cadastro da loja. PUBLIC_API_URL precisa ser HTTPS e
# acessivel pelo aparelho que le o QR. APP_DOWNLOAD_URL aponta para a pagina de
# download do app quando ela existir.
PUBLIC_API_URL=
APP_DOWNLOAD_URL=

# Recuperacao de senha. No app, mantenha o deep link abaixo; na web publicada,
# use uma URL HTTPS que abra a tela `redefinir-senha`.
PASSWORD_RESET_URL=detudoja://redefinir-senha
PASSWORD_RESET_EXPIRES_MINUTES=30

# Pedido pago sem aceite/preparo da loja e cancelado e estornado por worker.
ORDER_UNATTENDED_TIMEOUT_MINUTES=60
# Prestadores e motoboys deixam de aparecer se o app nao renovar o sinal neste prazo.
SERVICE_AVAILABILITY_TIMEOUT_SECONDS=120
# SMTP e opcional no ambiente local: sem ele a API imprime o link no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Brasil Cashback <no-reply@detudoja.local>"

# Opcional. Se vazio, usa storage/uploads na raiz do monorepo.
UPLOADS_DIR=
# Documentos KYC nunca ficam na pasta publica de uploads.
KYC_PRIVATE_DIR=

# Midias de chat ficam privadas e sao servidas somente apos autorizacao.
# No Docker, o volume persistente usa /app/storage/private/chat.
CHAT_PRIVATE_DIR=
# KYC local automatico: OCR + comparacao facial + antisspoof/liveness passivos.
KYC_MODE=automatic
# Em producao, mantenha false ate calibrar com documentos reais autorizados.
# Com false, casos validos ficam EM_ANALISE e nunca liberam TIER_2 sozinhos.
# Para exercitar a decisao automatica apenas em homologacao: use true aqui.
# Em homologacao, 0.00 permite decisao automatica. Em producao sem calibracao,
# use 1.00 para enviar todos os casos ao painel sem liberar TIER_2 pelo motor.
KYC_AUTOMATIC_APPROVAL_ENABLED=true
# 1.00 envia todos os casos validos para a fila de calibracao. Reduza somente
# apos medir falso aceite e falsa recusa com amostras autorizadas.
KYC_CALIBRATION_SAMPLE_RATE=0.00
# Confianca minima da deteccao facial. O exemplo oficial do Human usa 0.60.
KYC_FACE_DETECTION_THRESHOLD=0.60
KYC_FACE_MATCH_THRESHOLD=0.65
KYC_LIVENESS_THRESHOLD=0.50
KYC_ANTISPOOF_THRESHOLD=0.60
KYC_MINIMUM_FACE_AREA=0.06
KYC_NAME_MATCH_THRESHOLD=0.80
KYC_OCR_CONFIDENCE_THRESHOLD=0.65
# No Docker a API usa false e o container kyc-worker usa true.
KYC_WORKER_ENABLED=true

# Usado somente por `npm run seed:admin` para criar o primeiro administrador.
# O login sempre consulta a tabela `administradores` no PostgreSQL.
ADMIN_SEED_NAME=Administrador Local
ADMIN_SEED_EMAIL=admin@detudoja.local
ADMIN_SEED_PHONE=11999990000
ADMIN_SEED_PASSWORD=troque-esta-senha
# Somente em uma execucao manual do seed: permite redefinir o admin existente.
ADMIN_SEED_UPDATE_EXISTING=false

# Usuario raiz interno usado para cadastros sem codigo de indicacao.
# Ele vira o patrocinador "empresa" e posiciona esses usuarios na matriz 2x20.
COMPANY_ROOT_NAME=Brasil Cashback Empresa
COMPANY_ROOT_EMAIL=empresa@detudoja.local

# Use segredos longos e diferentes em cada ambiente.
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=detudoja-api

# Login social: use os IDs publicos criados nos consoles Google e Apple.
# Pode haver mais de um ID separado por virgula (iOS, Android e web).
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=com.detudoja.mobile

# Asaas: inicie com o Sandbox. Nunca exponha ASAAS_API_KEY no app mobile ou web.
# API Sandbox: https://api-sandbox.asaas.com/v3
# API Producao: https://api.asaas.com/v3
ASAAS_ENABLED=false
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_RECONCILIATION_GRACE_SECONDS=300
# Chamadas sem aceite e atendimentos sem interacao/proposta expiram automaticamente.
COURIER_REQUEST_TIMEOUT_MINUTES=40
SERVICE_IDLE_TIMEOUT_MINUTES=40

# Servico pago: prazo para o prestador iniciar e para o cliente contestar a entrega.
SERVICE_UNATTENDED_TIMEOUT_MINUTES=1440
SERVICE_CONFIRMATION_TIMEOUT_MINUTES=2880
# Copie a chave completa, inclusive o "$" inicial: $aact_hmlg_... no Sandbox.
ASAAS_API_KEY=
# Mesmo valor configurado em Integracoes > Webhooks do Asaas (32+ caracteres).
ASAAS_WEBHOOK_TOKEN=

# Sicredi Multipag: OAuth2 Client Credentials sobre mTLS.
# Nunca envie estas credenciais para o app mobile e nunca versione valores reais.
# O smoke test usa sandbox e multipag.pix.consultar por padrao.
SICREDI_MULTIPAG_ENV=sandbox
SICREDI_MULTIPAG_SCOPE=multipag.pix.consultar
SICREDI_MULTIPAG_CLIENT_ID=
SICREDI_MULTIPAG_CLIENT_SECRET=
# Certificado assinado PEM ou DER (.cer) + chave privada PEM. Alternativamente, PFX.
SICREDI_MULTIPAG_CERT_PATH=
SICREDI_MULTIPAG_KEY_PATH=
SICREDI_MULTIPAG_CHAIN_PATH=
SICREDI_MULTIPAG_PFX_PATH=
SICREDI_MULTIPAG_CERT_PASSPHRASE=
# Habilita a selecao Multipag para novos saques/repasses, conforme roteamento abaixo.
# Exige homologacao, persistencia e conciliacao antes de ativar em producao.
SICREDI_MULTIPAG_TRANSFER_ENABLED=false
SICREDI_MULTIPAG_COOPERATIVA=
SICREDI_MULTIPAG_CONTA=
SICREDI_MULTIPAG_DOCUMENTO=
SICREDI_MULTIPAG_API_URL=
SICREDI_MULTIPAG_AUTH_URL=
# Dados para o teste isolado de repasse no Sandbox; nao habilitam o app.
# Use dados de beneficiario de homologacao fornecidos pelo Sicredi.
SICREDI_MULTIPAG_TEST_DESTINATION_KEY_TYPE=
SICREDI_MULTIPAG_TEST_DESTINATION_KEY=
SICREDI_MULTIPAG_TEST_DESTINATION_DOCUMENT=
SICREDI_MULTIPAG_TEST_DESTINATION_NAME=
SICREDI_MULTIPAG_TEST_AMOUNT_CENTS=
SICREDI_MULTIPAG_TEST_DATE=

# API Pix de RECEBIMENTO: credenciais separadas das do Multipag.
# O Sicredi deve informar as URLs de homologacao; nao usar a URL de producao.
SICREDI_PIX_AUTH_URL=
SICREDI_PIX_API_URL=
SICREDI_PIX_CLIENT_ID=
SICREDI_PIX_CLIENT_SECRET=
SICREDI_PIX_RECEIVING_KEY=
# Pode apontar para o mesmo certificado aprovado, se vinculado a API Pix.
SICREDI_PIX_CERT_PATH=
SICREDI_PIX_KEY_PATH=
SICREDI_PIX_CHAIN_PATH=
SICREDI_PIX_CERT_PASSPHRASE=

# Gateway principal/fallback: a escolha e persistida ANTES da primeira requisicao.
# Nao ha reenvio ao fallback apos timeout/5xx. Operacoes antigas ficam no provedor original.
PAYMENTS_PRIMARY_GATEWAY=SICREDI
PAYMENTS_FALLBACK_GATEWAY=ASAAS
PAYMENTS_ENVIRONMENT=sandbox
# Somente em instalacao/banco isolados de teste; fixture Multipag nao quita operacoes reais.
SICREDI_APP_SANDBOX_ENABLED=false
# Credita saldos de teste pelo fluxo normal, via admin financeiro. Nunca em producao.
# A API recusa iniciar com ambiente real se esta base contiver simulacoes auditadas.
PAYMENTS_SANDBOX_MANUAL_APPROVAL_ENABLED=false
SICREDI_PIX_ENABLED=false
SICREDI_PIX_ENV=sandbox
# Segredos aleatorios de 32+ caracteres, diferentes das credenciais OAuth.
SICREDI_PIX_WEBHOOK_TOKEN=
SICREDI_MULTIPAG_WEBHOOK_TOKEN=
