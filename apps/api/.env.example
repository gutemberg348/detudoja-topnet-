PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:8082
DATABASE_URL=postgresql://admin:adimin@localhost:5432/meu_banco?schema=public

# Links usados no QR de cadastro da loja. PUBLIC_API_URL precisa ser HTTPS e
# acessivel pelo aparelho que le o QR. APP_DOWNLOAD_URL aponta para a pagina de
# download do app quando ela existir.
PUBLIC_API_URL=
APP_DOWNLOAD_URL=

# Opcional. Se vazio, usa storage/uploads na raiz do monorepo.
UPLOADS_DIR=

# Usado somente por `npm run seed:admin` para criar o primeiro administrador.
# O login sempre consulta a tabela `administradores` no PostgreSQL.
ADMIN_SEED_NAME=Administrador Local
ADMIN_SEED_EMAIL=admin@detudoja.local
ADMIN_SEED_PHONE=11999990000
ADMIN_SEED_PASSWORD=troque-esta-senha

# Usuario raiz interno usado para cadastros sem codigo de indicacao.
# Ele vira o patrocinador "empresa" e posiciona esses usuarios na matriz 2x20.
COMPANY_ROOT_NAME=DeTudoJa Empresa
COMPANY_ROOT_EMAIL=empresa@detudoja.local

# Use segredos longos e diferentes em cada ambiente.
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=detudoja-api

# Login social: use os IDs publicos criados nos consoles Google e Apple.
# Pode haver mais de um ID separado por virgula (iOS, Android e web).
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=com.detudoja.mobile

# Asaas: inicie com o Sandbox. Nunca exponha ASAAS_API_KEY no app mobile ou web.
# API Sandbox: https://api-sandbox.asaas.com/v3
# API Producao: https://api.asaas.com/v3
ASAAS_ENABLED=false
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Copie a chave completa, inclusive o "$" inicial: $aact_hmlg_... no Sandbox.
ASAAS_API_KEY=
# Mesmo valor configurado em Integracoes > Webhooks do Asaas (32+ caracteres).
ASAAS_WEBHOOK_TOKEN=
