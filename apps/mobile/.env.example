# API publica usada pelo aplicativo de testes.
EXPO_PUBLIC_API_URL=https://api-brasil.testes-techcode.shop

# IDs OAuth publicos. Nao coloque secrets do Google ou Apple no app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# APK usa WEB_CLIENT_ID no SDK; cliente Android (pacote + SHA-1) deve existir
# no mesmo projeto Google Cloud. Nao reutilizar o ID Web como ID iOS.
# Configure tambem no EAS antes do build. Ver docs/login-google.md.

# Preencha depois de executar `eas init`. Nao e segredo, mas identifica o app
# compilado que recebera notificacoes Expo.
EXPO_PUBLIC_EAS_PROJECT_ID=
