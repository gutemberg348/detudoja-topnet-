{
  "expo": {
    "name": "DeTudoJa",
    "slug": "detudoja",
    "scheme": "detudoja",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5FFF8",
      "image": "./assets/detudoja-logo-smile.png",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.detudoja.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5FFF8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.detudoja.mobile",
      "usesAppleSignIn": true,
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O DeTudoJa usa a camera para ler cobrancas QR com seguranca."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O DeTudoJa acessa suas fotos para enviar logo, banner e imagens de produtos."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication"
    ]
  }
}
