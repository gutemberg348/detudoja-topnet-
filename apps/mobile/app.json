{
  "expo": {
    "name": "Brasil Cashback",
    "slug": "brasil-cashback",
    "scheme": "detudoja",
    "icon": "./assets/brasil-cashback-app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5FFF8",
      "image": "./assets/brasil-cashback-logo.png",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.detudoja.mobile",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#F5FFF8",
        "foregroundImage": "./assets/brasil-cashback-app-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.detudoja.mobile",
      "usesAppleSignIn": true,
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brasil-cashback-logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O Brasil Cashback usa a camera para ler cobrancas QR com seguranca."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Brasil Cashback acessa suas fotos para enviar logo, banner e imagens de produtos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Brasil Cashback usa sua localizacao para mostrar lojas e servicos da sua cidade."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "a1b5369b-d353-4d57-80db-90d89fbbff40"
      }
    }
  }
}
